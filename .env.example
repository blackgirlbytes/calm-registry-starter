# Everything is optional for local dev: without Supabase the app stores data in
# .data/registries.json, without OpenAI it uses a scripted chat, and without
# retailer keys it shows sample products. Supabase is REQUIRED on Vercel.

# Supabase (server)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Supabase (browser: magic-link auth + realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Amazon Product Advertising API 5
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_PARTNER_TAG=

# Walmart Affiliate API (Impact)
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
WALMART_KEY_VERSION=1
WALMART_PUBLISHER_ID=

# Target Partners (Impact) tracking link base, e.g. https://goto.target.com/c/<pid>/<adid>/2092
TARGET_IMPACT_LINK=
